unit UnitConfiguracoes;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.Buttons, Vcl.ExtCtrls, Vcl.StdCtrls,
  Vcl.DBCtrls, Vcl.Imaging.jpeg, UPrincipal;

type
  TFrmConfiguracoesCompeticao = class(TForm)
    Panel1: TPanel;
    SpeedButton1: TSpeedButton;
    Label1: TLabel;
    Label2: TLabel;
    DBLookupComboBox1: TDBLookupComboBox;
    Label3: TLabel;
    Label4: TLabel;
    DBText1: TDBText;
    Label5: TLabel;
    DBText2: TDBText;
    Label6: TLabel;
    Shape1: TShape;
    Label7: TLabel;
    BitBtn1: TBitBtn;
    pnlPaisSorteado: TPanel;
    Shape2: TShape;
    Label9: TLabel;
    lblNomePaisSorteado: TLabel;
    Image1: TImage;
    procedure FormShow(Sender: TObject);
    procedure BitBtn1Click(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure Label1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FrmConfiguracoesCompeticao: TFrmConfiguracoesCompeticao;

implementation

{$R *.dfm}

uses UdmPrincipal, UDefinirParticipantes;

procedure TFrmConfiguracoesCompeticao.BitBtn1Click(Sender: TObject);
var
  iMaxTimes, iTimeSorteado: Integer;
  bSorteioValido: Boolean;
begin
  dmPrincipal.qry_Times.Close;
  dmPrincipal.qry_Times.SQL.Clear;
  dmPrincipal.qry_Times.SQL.Add( 'Select first 1 * from TTIMES order by CODIGO desc' );
  dmPrincipal.qry_Times.Open();

  iMaxTimes := dmPrincipal.qry_TimesCODIGO.AsInteger;

  bSorteioValido := False;
  Randomize;
  while not(bSorteioValido) do
  begin
    iTimeSorteado := Random(iMaxTimes);

    dmPrincipal.qry_Times.Close;
    dmPrincipal.qry_Times.SQL.Clear;
    dmPrincipal.qry_Times.SQL.Add( 'Select * from TTIMES where CODIGO = ' + QuotedStr(iTimeSorteado.ToString) );
    dmPrincipal.qry_Times.Open();

    if not(dmPrincipal.qry_Times.IsEmpty) then
    begin
      dmPrincipal.qry_CompeticaoANFITRIAO.AsInteger := dmPrincipal.qry_TimesCODIGO.AsInteger;
      lblNomePaisSorteado.Caption := dmPrincipal.qry_TimesSELECAO.AsString + ' (' + dmPrincipal.qry_TimesSIGLA.AsString + ')';
      lblNomePaisSorteado.Update;

      Image1.Picture.LoadFromFile( dmPrincipal.qry_TimesBANDEIRA.AsString );
      pnlPaisSorteado.Visible := True;
//      BitBtn1.Visible := False;
      bSorteioValido := True;
    end;

  end;



end;

procedure TFrmConfiguracoesCompeticao.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
  Action := TCloseAction.caFree;
end;

procedure TFrmConfiguracoesCompeticao.FormShow(Sender: TObject);
begin
  dmPrincipal.qry_Modelo.Close;
  dmPrincipal.qry_Modelo.Open();
end;

procedure TFrmConfiguracoesCompeticao.Label1Click(Sender: TObject);
begin
  if ( dmPrincipal.qry_CompeticaoANFITRIAO.IsNull) then
  begin
    MessageDlg('Sorteie o país anfitrião para prosseguir!', TMsgDlgType.mtInformation, [mbok],0);
    Exit;
  end;

  if not( Assigned(FrmDefinirParticipantes) ) then
  begin
    FrmDefinirParticipantes := TFrmDefinirParticipantes.Create(FrmPrincipal);
    FrmDefinirParticipantes.Parent := FrmPrincipal.pnlParent;
    FrmDefinirParticipantes.Show;
    FrmDefinirParticipantes.BringToFront;
    FrmPrincipal.PosicionarForm(FrmDefinirParticipantes)
    Self.Close;
  end;
end;

end.
