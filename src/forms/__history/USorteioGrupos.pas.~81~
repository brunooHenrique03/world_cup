  begin
    SortearProximo;
  end;

  MessageDlg('O Sorteio dos grupos foi finalizado!', TMsgDlgType.mtInformation, [mbok], 0);
end;

function TFrmSorteioGrupos.TemTime: Boolean;
begin
  Result := False;

  if ( Pote1.Locate( 'SORTEADO', 'NÃO', [] ) ) then
  begin
    Result := True;
    Exit;
  end;

  if ( Pote2.Locate( 'SORTEADO', 'NÃO', [] ) ) then
  begin
    Result := True;
    Exit;
  end;

  if ( Pote3.Locate( 'SORTEADO', 'NÃO', [] ) ) then
  begin
    Result := True;
    Exit;
  end;

  if ( Pote4.Locate( 'SORTEADO', 'NÃO', [] ) ) then
