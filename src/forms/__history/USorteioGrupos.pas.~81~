procedure TFrmSorteioGrupos.FormShow(Sender: TObject);
begin
  //Divisão dos potes
  //Pote 1 = Anfitrião + 11 melhores colocados

  Pote1.Close;
  Pote1.CreateDataSet;
  Pote2.Close;
  Pote2.CreateDataSet;
  Pote3.Close;
  Pote3.CreateDataSet;
  Pote4.Close;
  Pote4.CreateDataSet;

  dmPrincipal.qry_Times.Close;
  dmPrincipal.qry_Times.SQL.Clear;
  dmPrincipal.qry_Times.SQL.Add('Select * from TTIMES where CODIGO = ' + QuotedStr(dmPrincipal.qry_CompeticaoANFITRIAO.AsString) );
  dmPrincipal.qry_Times.Open();

  Pote1.Append;
  Pote1CODIGO.AsInteger  := dmPrincipal.qry_TimesCODIGO.AsInteger;
  Pote1SELECAO.AsString  := dmPrincipal.qry_TimesSELECAO.AsString;
  Pote1SORTEADO.AsString := 'SIM';
  Pote1.Post;

  //Restante dos times
  qry_SorteioPote.Close;
  qry_SorteioPote.Params.ParamByName( 'pCompeticao' ).AsInteger := dmPrincipal.qry_CompeticaoCODIGO.AsInteger;
  qry_SorteioPote.Open();
  qry_SorteioPote.First;

  PreencherPote(Pote1,1);
  PreencherPote(Pote2,2);
  PreencherPote(Pote3,3);
  PreencherPote(Pote4,4);

  qry_Grupos.Close;
  qry_Grupos.Params.ParamByName( 'pCompeticao' ).AsInteger := dmPrincipal.qry_CompeticaoCODIGO.AsInteger;
  qry_Grupos.Open();
  if (qry_grupos.IsEmpty) then
  begin
    qry_Grupos.Append;
    qry_GruposCODIGO.AsInteger     := dmPrincipal.GetNewID( 'TGRUPOS', 'CODIGO' );
    qry_GruposCOMPETICAO.AsInteger := dmPrincipal.qry_CompeticaoCODIGO.AsInteger;
    qry_GruposSELECAO.AsInteger    := dmPrincipal.qry_CompeticaoANFITRIAO.AsInteger;
    qry_GruposGRUPO.AsString       := 'A';
    qry_GruposPONTUACAO.AsInteger  := 0;
    qry_GruposVITORIAS.AsInteger   := 0;
    qry_GruposEMPATES.AsInteger    := 0;
    qry_GruposDERROTAS.AsInteger   := 0;
    qry_GruposGOLSFEITOS.AsInteger := 0;
    qry_GruposGOLSLEVADOS.AsInteger:= 0;
    qry_GruposSALDO.AsInteger      := 0;
    qry_GruposPOTEORIGEM.AsInteger := 1;
    qry_GruposRANKING.AsInteger    := 1;
    qry_Grupos.Post;
    dmPrincipal.ConexaoPrincipal.CommitRetaining;
  end;
end;

function TFrmSorteioGrupos.GetContinente(pIdTime: Integer): String;
begin
  dmPrincipal.qry_Times.Close;
  dmPrincipal.qry_Times.SQL.Clear;
  dmPrincipal.qry_Times.SQL.Add('Select * from TTIMES where CODIGO = ' + QuotedStr(pIdTime.ToString) );
  dmPrincipal.qry_Times.Open();

  Result := dmPrincipal.qry_TimesCONTINENTE.AsString;
end;

procedure TFrmSorteioGrupos.PreencherPote(pPote: TClientDataset; iNumPote: Integer);
begin
  qry_Potes.Close;
  qry_Potes.Open();

  while not( pPote.RecordCount >= 12 ) do
  begin
    if ( qry_SorteioPoteANFITRIAO.AsString <> 'SIM' ) then
    begin
      pPote.Append;
      pPote.Fields.FieldByName( 'CODIGO' ).AsInteger  := qry_SorteioPoteCODSELECAO.AsInteger;
      pPote.Fields.FieldByName( 'SELECAO' ).AsString  := qry_SorteioPoteSELECAO.AsString;
      pPote.Fields.FieldByName( 'SORTEADO' ).AsString := 'NÃO';
      pPote.Post;
    end;

    qry_Potes.Append;
    qry_PotesCODIGO.AsInteger     := dmPrincipal.GetNewID( 'TPOTES', 'CODIGO' );
    qry_PotesCOMPETICAO.AsInteger := dmPrincipal.qry_CompeticaoCODIGO.AsInteger;
    qry_PotesSELECAO.AsInteger    := qry_SorteioPoteCODSELECAO.AsInteger;
    qry_PotesPOTE.AsInteger       := iNumPote;
    qry_PotesPONTUACAO.AsInteger  := qry_SorteioPotePONTUACAO.AsInteger;
    qry_Potes.Post;

    qry_SorteioPote.Next;
  end;

  pPote.First;
end;

procedure TFrmSorteioGrupos.SortearProximo;
const
  ArrGrupos: Array[0..11] of Char = ('A','B','C','D','E','F','G','H','I','J','K','L');
var
  iSelecao,
  iPote,
  i,
  QtdEuropa: INteger;
  sContinente: String;
  GrupoPermitido: Char;
  PodeEntrar: Boolean;
begin
  if ( Pote1.Locate( 'SORTEADO', 'NÃO', [] ) ) then
  begin
    iSelecao := SortearSelecao( Pote1 );
    iPote    := 1;
  end
  else if ( Pote2.Locate( 'SORTEADO', 'NÃO', [] ) ) then
  begin
    iSelecao := SortearSelecao( Pote2 );
    iPote    := 2;
  end
  else if ( Pote3.Locate( 'SORTEADO', 'NÃO', [] ) ) then
  begin
    iSelecao := SortearSelecao( Pote3 );
    iPote    := 3;
  end
  else if ( Pote4.Locate( 'SORTEADO', 'NÃO', [] ) ) then
  begin
    iSelecao := SortearSelecao( Pote4 );
    iPote    := 4;
  end
  else
  begin
    MessageDlg('Todas as seleções foram sorteadas!', TMsgDlgType.mtWarning, [mbok], 0);
    Exit;
  end;


  sContinente := GetContinente( iSelecao );
  GrupoPermitido := 'Z';

  for i := 0 to Length(ArrGrupos)-1 do
  begin

    PodeEntrar := True;
    QtdEuropa := 0;

    qry_VerificaGrupo.Close;
    qry_VerificaGrupo.Params.ParamByName( 'pGrupo' ).AsString       := ArrGrupos[i];
    qry_VerificaGrupo.Params.ParamByName( 'pCompeticao' ).AsInteger := dmPrincipal.qry_CompeticaoCODIGO.AsInteger;
    qry_VerificaGrupo.Open();
    qry_VerificaGrupo.First;

    while not qry_VerificaGrupo.Eof do
    begin
      // ❌ mesmo pote
      if qry_VerificaGrupoPOTEORIGEM.AsInteger = iPote then
      begin
        PodeEntrar := False;
        Break;
      end;

      // continente
      if qry_VerificaGrupoCONTINENTE.AsString = sContinente then
      begin
        if sContinente <> 'EUROPA' then
        begin
          PodeEntrar := False;
          Break;
        end
        else
          Inc(QtdEuropa);
      end;

      qry_VerificaGrupo.Next;
    end;

    // Europa pode até 2
    if (sContinente = 'EUROPA') and (QtdEuropa >= 2) then
      PodeEntrar := False;

    if PodeEntrar then
    begin
      GrupoPermitido := ArrGrupos[i];
      Break; // ACHOU, acabou
    end;
  end;

  //---------- Se após o loop, continuar como Z, pega o que estiver disponível
  if GrupoPermitido = 'Z' then
  begin
    for i := Low(ArrGrupos) to High(ArrGrupos) do
    begin
      qry_VerificaGrupo.Close;
      qry_VerificaGrupo.ParamByName('pCompeticao').AsInteger :=
        dmPrincipal.qry_CompeticaoCODIGO.AsInteger;
      qry_VerificaGrupo.ParamByName('pGrupo').AsString := ArrGrupos[i];
      qry_VerificaGrupo.Open;

      if qry_VerificaGrupo.RecordCount >= 4 then
        Continue;

      PodeEntrar := True;
      qry_VerificaGrupo.First;

      while not qry_VerificaGrupo.Eof do
      begin
        if qry_VerificaGrupoPOTEORIGEM.AsInteger = iPote then
        begin
          PodeEntrar := False;
          Break;
        end;
        qry_VerificaGrupo.Next;
      end;

      if PodeEntrar then
      begin
        GrupoPermitido := ArrGrupos[i];
        Break;
      end;
    end;
  end;

  dmPrincipal.qry_Times.Close;
  dmPrincipal.qry_Times.SQL.Clear;
  dmPrincipal.qry_Times.SQL.Add('Select * from TTIMES where CODIGO = ' + QuotedStr(iSelecao.ToString) );
  dmPrincipal.qry_Times.Open();

  qry_Grupos.Close;
  qry_Grupos.Open();
  qry_Grupos.Append;
  qry_GruposCODIGO.AsInteger     := dmPrincipal.GetNewID( 'TGRUPOS', 'CODIGO' );
  qry_GruposCOMPETICAO.AsInteger := dmPrincipal.qry_CompeticaoCODIGO.AsInteger;
  qry_GruposSELECAO.AsInteger    := iSelecao;
  qry_GruposGRUPO.AsString       := GrupoPermitido;
  qry_GruposPONTUACAO.AsInteger  := 0;
  qry_GruposVITORIAS.AsInteger   := 0;
  qry_GruposEMPATES.AsInteger    := 0;
  qry_GruposDERROTAS.AsInteger   := 0;
  qry_GruposGOLSFEITOS.AsInteger := 0;
  qry_GruposGOLSLEVADOS.AsInteger:= 0;
  qry_GruposSALDO.AsInteger      := 0;
  qry_GruposPOTEORIGEM.AsInteger := iPote;
  qry_GruposRANKING.AsInteger    := iPote;
  qry_Grupos.Post;
  dmPrincipal.ConexaoPrincipal.CommitRetaining;
end;



function TFrmSorteioGrupos.SortearSelecao(pPote: TClientDataset): Integer;
var
  bSorteado: Boolean;
  ArrSelecoes: Array of Integer;
begin
  try
    pPote.DisableControls;
    bSorteado := False;
    pPote.First;
    while not(pPote.Eof) do
    begin
      if (pPote.Fields.FieldByName( 'SORTEADO' ).AsString <> 'SIM') then
      begin
        SetLength(ArrSelecoes, Length(ArrSelecoes) + 1);
        ArrSelecoes[ Length(ArrSelecoes) - 1 ] := pPote.Fields.FieldByName( 'CODIGO' ).AsInteger;
      end;

      pPote.Next;
    end;

    randomize;
    if ( Length(ArrSelecoes) = 1 ) then
      Result := ArrSelecoes[0]
    else
      Result := ArrSelecoes[ random( Length(ArrSelecoes) ) ];

    if (pPote.Locate( 'CODIGO', IntToStr(Result), [] )) then
    begin
      pPote.Edit;
      pPote.Fields.FieldByName( 'SORTEADO' ).AsString := 'SIM';
      pPote.Post;
    end;


  finally
    pPote.First;
    pPote.EnableControls;
  end;

end;

procedure TFrmSorteioGrupos.SpeedButton1Click(Sender: TObject);
const
  ArrGrupos: Array[0..11] of Char = ('A','B','C','D','E','F','G','H','I','J','K','L');
var
  i, j, iNumPartida: Integer;
  confronto1, confronto2: array[0..1] of integer;
begin
  if (TemTime) then
  begin
    MessageDlg('Finalize o Sorteio dos grupos para prosseguir!', TMsgDlgType.mtWarning, [mbok], 0);
    Exit;
  end;

  qry_Grupos.Close;
  qry_Grupos.SQL.Clear;
  qry_Grupos.SQL.Add( 'Select * from TGRUPOS' );
  qry_Grupos.SQL.Add( 'where COMPETICAO = ' + QuotedStr(dmPrincipal.qry_CompeticaoCODIGO.AsString) );
  qry_Grupos.SQL.Add( 'and GRUPO = :pGrupo and ((RANKING = :pIndex1) or (RANKING = :pIndex2))' );

  //realiza os confrontos
  qry_Confrontos.Close;
  qry_Confrontos.Params.ParamByName( 'pCompeticao' ).AsInteger := dmPrincipal.qry_CompeticaoCODIGO.AsInteger;
  qry_Confrontos.Open();

  iNumPartida := 1;

  for i := 1 to 3 do
  begin
    if (i=1) then
    begin
      confronto1[0] := 1;
      confronto1[1] := 2;
      confronto2[0] := 3;
      confronto2[1] := 4;
    end else if (i=2) then
    begin
      confronto1[0] := 1;
      confronto1[1] := 3;
      confronto2[0] := 2;
      confronto2[1] := 4;
    end else
    begin
      confronto1[0] := 1;
      confronto1[1] := 4;
      confronto2[0] := 2;
      confronto2[1] := 3;
    end;

    for j := 0 to Length(ArrGrupos) - 1 do
    begin
      qry_Grupos.Close;
      qry_Grupos.Params.ParamByName('pGrupo').AsString   := ArrGrupos[j];
      qry_Grupos.Params.ParamByName('pIndex1').AsInteger := confronto1[0];
      qry_Grupos.Params.ParamByName('pIndex2').AsInteger := confronto1[1];
      qry_Grupos.Open();

      qry_Grupos.First;
      dmPrincipal.qry_Times.Close;
      dmPrincipal.qry_Times.SQL.Clear;
      dmPrincipal.qry_Times.SQL.Add('Select * from TTIMES where CODIGO = ' + QuotedStr(qry_GruposSELECAO.AsString) );
      dmPrincipal.qry_Times.Open();

      qry_Confrontos.Append;
      qry_ConfrontosCODIGO.AsInteger        := dmPrincipal.GetNewID( 'TCONFRONTOS', 'CODIGO' );
      qry_ConfrontosCOMPETICAO.AsInteger    := dmPrincipal.qry_CompeticaoCODIGO.AsInteger;
      qry_ConfrontosRODADA.AsInteger        := i;
      qry_ConfrontosNUMEROPARTIDA.AsInteger := iNumPartida;
      qry_ConfrontosENCERRADO.AsString      := 'NÃO';
      qry_ConfrontosCODSELECAO1.AsInteger   := dmPrincipal.qry_TimesCODIGO.AsInteger;
      qry_ConfrontosSELECAO1.AsString       := dmPrincipal.qry_TimesSELECAO.AsString;
      qry_ConfrontosGOLSELECAO1.AsInteger   := 0;
      qry_ConfrontosFLAGSELECAO1.AsString   := dmPrincipal.qry_TimesBANDEIRA.AsString;

      qry_Grupos.Last;
      dmPrincipal.qry_Times.Close;
      dmPrincipal.qry_Times.SQL.Clear;
      dmPrincipal.qry_Times.SQL.Add('Select * from TTIMES where CODIGO = ' + QuotedStr(qry_GruposSELECAO.AsString) );
      dmPrincipal.qry_Times.Open();

      qry_ConfrontosCODSELECAO2.AsInteger   := dmPrincipal.qry_TimesCODIGO.AsInteger;
      qry_ConfrontosSELECAO2.AsString       := dmPrincipal.qry_TimesSELECAO.AsString;
      qry_ConfrontosGOLSELECAO2.AsInteger   := 0;
      qry_ConfrontosFLAGSELECAO2.AsString   := dmPrincipal.qry_TimesBANDEIRA.AsString;

      qry_Confrontos.Post;
      qry_Confrontos.Connection.CommitRetaining;

      inc(iNumPartida);

      qry_Grupos.Close;
      qry_Grupos.Params.ParamByName('pGrupo').AsString   := ArrGrupos[j];
      qry_Grupos.Params.ParamByName('pIndex1').AsInteger := confronto2[0];
      qry_Grupos.Params.ParamByName('pIndex2').AsInteger := confronto2[1];
      qry_Grupos.Open();

      qry_Grupos.First;
      dmPrincipal.qry_Times.Close;
      dmPrincipal.qry_Times.SQL.Clear;
      dmPrincipal.qry_Times.SQL.Add('Select * from TTIMES where CODIGO = ' + QuotedStr(qry_GruposSELECAO.AsString) );
      dmPrincipal.qry_Times.Open();

      qry_Confrontos.Append;
      qry_ConfrontosCODIGO.AsInteger        := dmPrincipal.GetNewID( 'TCONFRONTOS', 'CODIGO' );
      qry_ConfrontosCOMPETICAO.AsInteger    := dmPrincipal.qry_CompeticaoCODIGO.AsInteger;
      qry_ConfrontosRODADA.AsInteger        := i;
      qry_ConfrontosNUMEROPARTIDA.AsInteger := iNumPartida;
      qry_ConfrontosENCERRADO.AsString      := 'NÃO';
      qry_ConfrontosCODSELECAO1.AsInteger   := dmPrincipal.qry_TimesCODIGO.AsInteger;
      qry_ConfrontosSELECAO1.AsString       := dmPrincipal.qry_TimesSELECAO.AsString;
      qry_ConfrontosGOLSELECAO1.AsInteger   := 0;
      qry_ConfrontosFLAGSELECAO1.AsString   := dmPrincipal.qry_TimesBANDEIRA.AsString;

      qry_Grupos.Last;
      dmPrincipal.qry_Times.Close;
      dmPrincipal.qry_Times.SQL.Clear;
      dmPrincipal.qry_Times.SQL.Add('Select * from TTIMES where CODIGO = ' + QuotedStr(qry_GruposSELECAO.AsString) );
      dmPrincipal.qry_Times.Open();

      qry_ConfrontosCODSELECAO2.AsInteger   := dmPrincipal.qry_TimesCODIGO.AsInteger;
      qry_ConfrontosSELECAO2.AsString       := dmPrincipal.qry_TimesSELECAO.AsString;
      qry_ConfrontosGOLSELECAO2.AsInteger   := 0;
      qry_ConfrontosFLAGSELECAO2.AsString   := dmPrincipal.qry_TimesBANDEIRA.AsString;

      qry_Confrontos.Post;
      qry_Confrontos.Connection.CommitRetaining;

      inc(iNumPartida);
    end;

  end;


  FrmChaveamento := TFrmChaveamento.Create(FrmPrincipal);
  try
    FrmChaveamento.ShowModal;
  finally
    FreeAndNil(FrmChaveamento);
  end;

  Self.Close;
end;

